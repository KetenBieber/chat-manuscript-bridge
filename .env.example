# Copy to a private .env file. NEVER commit real credentials.
BRIDGE_TRANSPORT=http
BRIDGE_ALLOWED_HOST=localhost
BRIDGE_MCP_TOKEN=replace-with-a-random-token-of-at-least-24-characters
BRIDGE_GITHUB_REPO=your-account/your-private-data-repository
BRIDGE_GITHUB_BRANCH=main
BRIDGE_GITHUB_TOKEN=your-fine-grained-github-token
BRIDGE_STORAGE_PREFIX=manuscripts/v1
# Logical identifiers, not Feishu folder tokens. Empty = reject approval.
BRIDGE_ALLOWED_DESTINATIONS=personal-knowledge-base
# Optional: read-only compatibility inspection of a previous private store
# BRIDGE_LEGACY_PREFIX=your/legacy/prefix

# Optional poster export: allow only approved author's Figure image hosts.
# Example: BRIDGE_POSTER_IMAGE_HOSTS=example.org,authors.example.net
# BRIDGE_POSTER_IMAGE_HOSTS=

# Optional Feishu IM notification after verified publication+layout.
# Actual Feishu document upload still requires an external delivery worker.
# FEISHU_APP_ID=your-app-id
# FEISHU_APP_SECRET=your-app-secret
# FEISHU_NOTIFY_RECEIVE_ID_TYPE=open_id
# FEISHU_NOTIFY_RECEIVE_ID=your-authorized-recipient-id
