# Copy to a private .env file. NEVER commit real credentials.
BRIDGE_TRANSPORT=http
BRIDGE_ALLOWED_HOST=localhost
BRIDGE_MCP_TOKEN=replace-with-a-random-token-of-at-least-24-characters
BRIDGE_GITHUB_REPO=your-account/your-private-data-repository
BRIDGE_GITHUB_BRANCH=main
BRIDGE_GITHUB_TOKEN=your-fine-grained-github-token
BRIDGE_STORAGE_PREFIX=manuscripts/v1
# Logical identifiers, not Feishu folder tokens. Empty = reject approval.
BRIDGE_ALLOWED_DESTINATIONS=personal-knowledge-base
